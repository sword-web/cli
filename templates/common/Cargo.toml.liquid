[package]
name = "{{ project_name }}"
version = "0.1.0"
edition = "2024"
rust-version = "1.95"

[package.metadata.sword]
project-type = "{{ project_type }}"

[dependencies]
sword = { git = "https://github.com/sword-web/sword", rev = "{{ sword_rev }}", features = [{{ sword_features_quoted }}] }
serde = { version = "1", features = ["derive"] }
tokio = { version = "1", features = ["full"] }
thiserror = "2"
{% if project_type == "grpc" %}
tonic = "0.14"
tonic-prost = "0.14"
prost = "0.14"

[build-dependencies]
tonic-prost-build = "0.14"
{% endif %}
